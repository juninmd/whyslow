{
  "name": "whyslow",
  "version": "0.1.0",
  "type": "module",
  "description": "Mede DNS, TCP, TLS, TTFB e download separadamente e diz qual fase está lenta.",
  "homepage": "https://github.com/juninmd/whyslow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juninmd/whyslow.git"
  },
  "bugs": {
    "url": "https://github.com/juninmd/whyslow/issues"
  },
  "keywords": ["http", "latency", "dns", "tls", "diagnostics", "cli"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "whyslow": "dist/cli.js"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "bun test",
    "test:package": "node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.3.13",
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
